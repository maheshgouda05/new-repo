# ==============================================================================
# ANALYTIX CLUB - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your Supabase project credentials.
#
# Obtain these from:
# Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase Public Anonymous API Key (used for client requests)
SUPABASE_KEY=

# Supabase Service Role Key (secret key used by backend for admin operations)
# KEEP THIS SECRET! Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (found in Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

